# Konfigurasi npm untuk proyek ini.
# Tujuannya: instalasi tetap terlihat progresnya dan tidak menggantung
# di mesin berspesifikasi rendah (HDD 5400 rpm + antivirus real-time).

# Tampilkan progres instalasi agar tidak terlihat "macet" saat reify berjalan lama.
progress=true

# Jangan jalankan audit/funding saat instalasi; keduanya menambah request jaringan.
audit=false
fund=false

# Gunakan cache lokal lebih dulu supaya tidak mengunduh ulang tarball.
prefer-offline=true

# Batasi koneksi paralel agar tidak membebani disk/jaringan di mesin rendah spesifikasi.
maxsockets=5

# Beri kesempatan retry lebih besar ketika jaringan lambat.
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
